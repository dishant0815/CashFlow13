# CashFlow13 — no env vars are required. The demo runs on the pre-computed
# mock scenarios in data/scenarios/.

# Optional: Plaid sandbox keys. When set, "Connect bank" opens the real
# Plaid sandbox login (user_good / pass_good) before loading the demo
# scenario. When unset, the button skips straight to the progress animation.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
